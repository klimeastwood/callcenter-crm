APP_NAME='CRYPTOISK'
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en
APP_CURRENCY=USD

VITE_HOST=
VITE_PORT=

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Supported: mysql, mariadb
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel-crm
DB_USERNAME=root
DB_PASSWORD=
DB_PREFIX=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=laravel@krayincrm.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_DOMAIN=webkul.com

MAIL_RECEIVER_DRIVER=sendgrid
MAIL_RECEIVER_INBOUND_TOKEN=

IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_VALIDATE_CERT=true
IMAP_USERNAME=your_username
IMAP_PASSWORD=your_password

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

NOTIFICATION_DRIVER=polling
NOTIFICATION_POLL_INTERVAL=30

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# crypto-trading bridge (balance adjustments)
# driver=http talks to the trading app over the bridge, driver=database writes
# straight into the shared tables (no bridge needed, same rules).
CRM_TRADING_DRIVER=http
CRM_TRADING_URL=http://127.0.0.1:8001
# Must equal TRADING_BRIDGE_TOKEN of the trading application.
CRM_TRADING_TOKEN=
# Allow a direct database write when the bridge does not answer (shared DB only).
CRM_TRADING_FALLBACK=false
# Seconds to wait for the bridge, and the ceiling for a single change in USD.
CRM_TRADING_TIMEOUT=5
CRM_TRADING_MAX_AMOUNT=1000000
# Same value as WITHDRAWAL_CARD_KEY in the trading application
WITHDRAWAL_CARD_KEY=
# Clients of the trading cabinet are CRM users carrying the role the trading
# application gives them. They are excluded from the "Sales Owner" lookup and
# from the owner filter of the lead list; both the names and the ids are read,
# because the trading side may create the role by name or reuse one by id.
CRM_TRADING_CLIENT_ROLES="Trading Client"
CRM_TRADING_CLIENT_ROLE_IDS=

